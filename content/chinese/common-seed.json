  "description": "國中常見錯別字、易錯字音與字義（不限課次）。每題上線前須對照教育部《重編國語辭典修訂本》確認，確認後把 verified 改成 true。",
  "textbook": null,
  "questions": [
    { "id": "fix-001", "type": "fix_char", "lesson": null, "sentence": "聽到要去動物園，弟弟迫不急待地衝出門。", "wrong_char": "急", "correct_char": "及", "word": "迫不及待", "explanation": "「及」是「到、趕上」。迫不及待＝急得等不到那時候。", "source": "seed-common", "verified": false },
    { "id": "fix-002", "type": "fix_char", "lesson": null, "sentence": "這次比賽輸了沒關係，下次再接再勵！", "wrong_char": "勵", "correct_char": "厲", "word": "再接再厲", "explanation": "「厲」同「礪」，是磨刀石，引申為磨練、努力，不是「鼓勵」的「勵」。", "source": "seed-common", "verified": false },
    { "id": "fix-003", "type": "fix_char", "lesson": null, "sentence": "他一股作氣跑完了全程。", "wrong_char": "股", "correct_char": "鼓", "word": "一鼓作氣", "explanation": "「鼓」是打鼓。古代打仗第一次擊鼓時，士兵的勇氣最旺盛。", "source": "seed-common", "verified": false },
    { "id": "fix-004", "type": "fix_char", "lesson": null, "sentence": "學習要按步就班，不能急著跳到最難的地方。", "wrong_char": "步", "correct_char": "部", "word": "按部就班", "explanation": "「部」是門類、次序。按部就班＝照著一定的次序來做。", "source": "seed-common", "verified": false },
    { "id": "fix-005", "type": "fix_char", "lesson": null, "sentence": "看到哥哥的棋藝，我真是甘敗下風。", "wrong_char": "敗", "correct_char": "拜", "word": "甘拜下風", "explanation": "「拜」是佩服、拜服。甘願佩服對方，承認自己比不上。", "source": "seed-common", "verified": false },
    { "id": "fix-006", "type": "fix_char", "lesson": null, "sentence": "小偷被警察包圍，已經走頭無路了。", "wrong_char": "頭", "correct_char": "投", "word": "走投無路", "explanation": "「投」是投奔、投靠。沒有地方可以投奔。", "source": "seed-common", "verified": false },
    { "id": "fix-007", "type": "fix_char", "lesson": null, "sentence": "爺爺和老朋友談笑風聲，聊得好開心。", "wrong_char": "聲", "correct_char": "生", "word": "談笑風生", "explanation": "「風生」是說話生動有趣，好像有風吹起來一樣，跟「聲音」無關。", "source": "seed-common", "verified": false },
    { "id": "fix-008", "type": "fix_char", "lesson": null, "sentence": "他總是默守成規，不肯嘗試新方法。", "wrong_char": "默", "correct_char": "墨", "word": "墨守成規", "explanation": "「墨」是指墨子（墨翟），他很會守城。後來比喻死守舊方法。", "source": "seed-common", "verified": false },
    { "id": "fix-009", "type": "fix_char", "lesson": null, "sentence": "山裡的小村莊安靜美麗，像世外桃園一樣。", "wrong_char": "園", "correct_char": "源", "word": "世外桃源", "explanation": "出自陶淵明〈桃花源記〉，「源」是水源，沿著溪水走到源頭才找到這個地方。", "source": "seed-common", "verified": false },
    { "id": "fix-010", "type": "fix_char", "lesson": null, "sentence": "他答應的事一定做到，真是一諾千斤。", "wrong_char": "斤", "correct_char": "金", "word": "一諾千金", "explanation": "「金」是金子。一句承諾比千兩黃金還珍貴，形容很守信用。", "source": "seed-common", "verified": false },
    { "id": "fix-011", "type": "fix_char", "lesson": null, "sentence": "河水快要淹進村子了，疏散村民刻不容援。", "wrong_char": "援", "correct_char": "緩", "word": "刻不容緩", "explanation": "「緩」是延緩、拖延。一刻也不能拖延。", "source": "seed-common", "verified": false },
    { "id": "fix-012", "type": "fix_char", "lesson": null, "sentence": "老師一問，她不加思索就說出了答案。", "wrong_char": "加", "correct_char": "假", "word": "不假思索", "explanation": "「假」是借助。不需要借助思考，形容反應很快。", "source": "seed-common", "verified": false },
    { "id": "fix-013", "type": "fix_char", "lesson": null, "sentence": "他想了半天，還是一愁莫展。", "wrong_char": "愁", "correct_char": "籌", "word": "一籌莫展", "explanation": "「籌」是計策。一點計策也想不出來，跟「發愁」無關。", "source": "seed-common", "verified": false },
    { "id": "fix-014", "type": "fix_char", "lesson": null, "sentence": "第一次上台難免緊張，這是再所難免的。", "wrong_char": "再", "correct_char": "在", "word": "在所難免", "explanation": "「在」是存在於。在這種情況下難以避免。", "source": "seed-common", "verified": false },
    { "id": "fix-015", "type": "fix_char", "lesson": null, "sentence": "新蓋好的圖書館美輪美煥，大家都很喜歡。", "wrong_char": "煥", "correct_char": "奐", "word": "美輪美奐", "explanation": "「奐」是盛大、眾多，形容房子高大漂亮；「煥」是光亮（煥然一新）。", "source": "seed-common", "verified": false },
    { "id": "fix-016", "type": "fix_char", "lesson": null, "sentence": "明天就要段考，複習已經迫在眉梢了。", "wrong_char": "梢", "correct_char": "睫", "word": "迫在眉睫", "explanation": "「睫」是眼睫毛。事情近得就在眼睛前面，非常緊急。", "source": "seed-common", "verified": false },
    { "id": "fix-017", "type": "fix_char", "lesson": null, "sentence": "為了不吵架，他只好委屈求全。", "wrong_char": "屈", "correct_char": "曲", "word": "委曲求全", "explanation": "「曲」是彎曲。委曲＝彎下身子遷就別人，為了保全大局。", "source": "seed-common", "verified": false },
    { "id": "fix-018", "type": "fix_char", "lesson": null, "sentence": "夜市裡的遊客穿流不息。", "wrong_char": "穿", "correct_char": "川", "word": "川流不息", "explanation": "「川」是河流。人或車像河水一樣不停地流動。", "source": "seed-common", "verified": false },
    { "id": "fix-019", "type": "fix_char", "lesson": null, "sentence": "這支球隊出奇不意地攻下了一分。", "wrong_char": "奇", "correct_char": "其", "word": "出其不意", "explanation": "「其」是指對方。趁對方沒有想到的時候行動。", "source": "seed-common", "verified": false },
    { "id": "fix-020", "type": "fix_char", "lesson": null, "sentence": "他做事總是虎頭蛇尾，從來沒有貫徹始終，真是半途而費。", "wrong_char": "費", "correct_char": "廢", "word": "半途而廢", "explanation": "「廢」是停止、放棄。走到一半就停下來。", "source": "seed-common", "verified": false },

    { "id": "rd-001", "type": "reading_choice", "lesson": null, "context": "他因為長期「酗」酒，身體越來越差。", "target": "酗", "options": ["ㄒㄩㄥ", "ㄒㄩˋ", "ㄐㄩˋ", "ㄒㄧㄡˋ"], "answer": 1, "explanation": "「酗」讀 ㄒㄩˋ，不能讀半邊唸成「凶」。左邊「酉」跟酒有關。", "trap": "讀半邊", "source": "seed-common", "verified": false },
    { "id": "rd-002", "type": "reading_choice", "lesson": null, "context": "這張紙摸起來很粗「糙」。", "target": "糙", "options": ["ㄗㄠˋ", "ㄘㄠˇ", "ㄘㄠ", "ㄗㄠ"], "answer": 2, "explanation": "「糙」讀 ㄘㄠ（一聲），不要跟「造」的 ㄗㄠˋ 搞混。", "trap": "讀半邊", "source": "seed-common", "verified": false },
    { "id": "rd-003", "type": "reading_choice", "lesson": null, "context": "教室裡充滿歡樂的「氛」圍。", "target": "氛", "options": ["ㄈㄣˋ", "ㄈㄣ", "ㄈㄣˊ", "ㄈㄣˇ"], "answer": 1, "explanation": "「氛」讀 ㄈㄣ（一聲）。", "trap": "聲調", "source": "seed-common", "verified": false },
    { "id": "rd-004", "type": "reading_choice", "lesson": null, "context": "他不應該包「庇」做錯事的朋友。", "target": "庇", "options": ["ㄆㄧˋ", "ㄅㄧˇ", "ㄅㄧˋ", "ㄆㄧ"], "answer": 2, "explanation": "「庇」讀 ㄅㄧˋ，是遮蔽、保護的意思。", "trap": "聲母", "source": "seed-common", "verified": false },
    { "id": "rd-005", "type": "reading_choice", "lesson": null, "context": "她對未來充滿憧「憬」。", "target": "憬", "options": ["ㄐㄧㄥˇ", "ㄐㄧㄥ", "ㄧㄥˇ", "ㄐㄧㄥˋ"], "answer": 0, "explanation": "「憬」讀 ㄐㄧㄥˇ，跟「景」同音。憧憬＝嚮往。", "trap": "聲調", "source": "seed-common", "verified": false },
    { "id": "rd-006", "type": "reading_choice", "lesson": null, "context": "這件事由班長負責「處」理。", "target": "處", "options": ["ㄔㄨˋ", "ㄔㄨˇ", "ㄔㄨ", "ㄓㄨˇ"], "answer": 1, "explanation": "「處」當動詞（處理、相處）讀 ㄔㄨˇ；當名詞（處所、好處）讀 ㄔㄨˋ。", "trap": "多音字", "source": "seed-common", "verified": false },
    { "id": "rd-007", "type": "reading_choice", "lesson": null, "context": "花園裡的樹木高低參「差」。", "target": "差", "options": ["ㄔㄚ", "ㄔㄞ", "ㄘ", "ㄔㄚˋ"], "answer": 2, "explanation": "「參差」讀 ㄘㄣ ㄘ，是長短高低不整齊的樣子。", "trap": "多音字", "source": "seed-common", "verified": false },
    { "id": "rd-008", "type": "reading_choice", "lesson": null, "context": "「塞」翁失馬，焉知非福。", "target": "塞", "options": ["ㄙㄜˋ", "ㄙㄞ", "ㄙㄞˋ", "ㄙㄜ"], "answer": 2, "explanation": "「塞」指邊塞（邊境）時讀 ㄙㄞˋ；塞車、堵塞讀 ㄙㄜˋ。", "trap": "多音字", "source": "seed-common", "verified": false },
    { "id": "rd-009", "type": "reading_choice", "lesson": null, "context": "比賽「暫」時停止，等雨停再繼續。", "target": "暫", "options": ["ㄓㄢˇ", "ㄓㄢˋ", "ㄗㄢˋ", "ㄓㄢ"], "answer": 1, "explanation": "「暫」讀 ㄓㄢˋ（四聲），很多人會唸成三聲。", "trap": "聲調", "source": "seed-common", "verified": false },
    { "id": "rd-010", "type": "reading_choice", "lesson": null, "context": "同學們都叫他的「綽」號「小胖」。", "target": "綽", "options": ["ㄓㄨㄛˊ", "ㄔㄠˋ", "ㄔㄨㄛˋ", "ㄓㄠ"], "answer": 2, "explanation": "「綽號」的「綽」讀 ㄔㄨㄛˋ，不能讀半邊唸成「卓」。", "trap": "讀半邊", "source": "seed-common", "verified": false },
    { "id": "rd-011", "type": "reading_choice", "lesson": null, "context": "這條山路非常狹「隘」。", "target": "隘", "options": ["ㄧˋ", "ㄞˋ", "ㄜˋ", "ㄞˊ"], "answer": 1, "explanation": "「隘」讀 ㄞˋ，是狹窄的意思，不要讀成右邊「益」的 ㄧˋ。", "trap": "讀半邊", "source": "seed-common", "verified": false },
    { "id": "rd-012", "type": "reading_choice", "lesson": null, "context": "學好數學不是一「蹴」可幾的事。", "target": "蹴", "options": ["ㄐㄧㄡˋ", "ㄘㄨˋ", "ㄐㄧㄡ", "ㄙㄨˋ"], "answer": 1, "explanation": "「蹴」讀 ㄘㄨˋ，是踏、踢的意思，不能讀半邊唸成「就」。一蹴可幾＝踏一步就能達到。", "trap": "讀半邊", "source": "seed-common", "verified": false },
    { "id": "rd-013", "type": "reading_choice", "lesson": null, "context": "他們兩人的友「誼」很深厚。", "target": "誼", "options": ["ㄧˊ", "ㄧˋ", "ㄧ", "ㄧˇ"], "answer": 1, "explanation": "依教育部審訂，「誼」讀 ㄧˋ（四聲）。", "trap": "審訂音", "source": "seed-common", "verified": false, "review_note": "審訂音題目，上線前務必查教育部辭典確認" },
    { "id": "rd-014", "type": "reading_choice", "lesson": null, "context": "媽媽到「銀行」去存錢。「行」的讀音是？", "target": "行", "options": ["ㄒㄧㄥˊ", "ㄏㄤˊ", "ㄏㄤˋ", "ㄒㄧㄥˋ"], "answer": 1, "explanation": "「行」指行業、店家（銀行、行列）讀 ㄏㄤˊ；走路、可以（行走、不行）讀 ㄒㄧㄥˊ。", "trap": "多音字", "source": "seed-common", "verified": false },
    { "id": "rd-015", "type": "reading_choice", "lesson": null, "context": "「長」大以後，我想當老師。", "target": "長", "options": ["ㄔㄤˊ", "ㄓㄤˇ", "ㄓㄤˋ", "ㄔㄤˇ"], "answer": 1, "explanation": "「長」當成長、年紀大（長大、班長）讀 ㄓㄤˇ；當長短讀 ㄔㄤˊ。", "trap": "多音字", "source": "seed-common", "verified": false },

    { "id": "zc-001", "type": "zhuyin_to_char", "lesson": null, "sentence": "這次輸了，下次再接再（ㄌㄧˋ）。", "answer": "厲", "explanation": "「厲」是磨練、努力。不是「鼓勵」的「勵」。", "source": "seed-common", "verified": false },
    { "id": "zc-002", "type": "zhuyin_to_char", "lesson": null, "sentence": "段考已經迫在眉（ㄐㄧㄝˊ）了。", "answer": "睫", "explanation": "「睫」是眼睫毛，形容事情近在眼前。", "source": "seed-common", "verified": false },
    { "id": "zc-003", "type": "zhuyin_to_char", "lesson": null, "sentence": "新的圖書館美輪美（ㄏㄨㄢˋ）。", "answer": "奐", "explanation": "「奐」是盛大、眾多，形容建築高大華麗。", "source": "seed-common", "verified": false },
    { "id": "zc-004", "type": "zhuyin_to_char", "lesson": null, "sentence": "他鬼鬼（ㄙㄨㄟˋ）（ㄙㄨㄟˋ）地躲在牆角。", "answer": "祟祟", "explanation": "「祟」下面是「示」，表示鬼神作怪；不是「崇」。", "source": "seed-common", "verified": false },
    { "id": "zc-005", "type": "zhuyin_to_char", "lesson": null, "sentence": "想了很久，還是一（ㄔㄡˊ）莫展。", "answer": "籌", "explanation": "「籌」是計策、辦法。", "source": "seed-common", "verified": false },
    { "id": "zc-006", "type": "zhuyin_to_char", "lesson": null, "sentence": "做事要按（ㄅㄨˋ）就班。", "answer": "部", "explanation": "「部」是門類、次序。", "source": "seed-common", "verified": false },

    { "id": "mn-001", "type": "meaning_choice", "lesson": null, "context": "走馬看花", "target": "走", "options": ["走路", "跑", "離開", "經過"], "answer": 1, "explanation": "古文的「走」是「跑」。騎著快跑的馬看花，比喻看得很粗略。", "source": "seed-common", "verified": false },
    { "id": "mn-002", "type": "meaning_choice", "lesson": null, "context": "不假思索", "target": "假", "options": ["虛假", "放假", "借助", "如果"], "answer": 2, "explanation": "「假」是借助。不需要借助思考就做出反應。", "source": "seed-common", "verified": false },
    { "id": "mn-003", "type": "meaning_choice", "lesson": null, "context": "一籌莫展", "target": "籌", "options": ["計策", "籌碼的數量", "準備", "憂愁"], "answer": 0, "explanation": "「籌」在這裡是計策、辦法。一點辦法也沒有。", "source": "seed-common", "verified": false },
    { "id": "mn-004", "type": "meaning_choice", "lesson": null, "context": "走投無路", "target": "投", "options": ["丟擲", "投票", "投奔、投靠", "投入"], "answer": 2, "explanation": "「投」是投奔。沒有地方可以投靠。", "source": "seed-common", "verified": false },
    { "id": "mn-005", "type": "meaning_choice", "lesson": null, "context": "出其不意", "target": "其", "options": ["那個東西", "對方", "自己", "其他"], "answer": 1, "explanation": "「其」是代詞，指對方。趁對方沒想到時行動。", "source": "seed-common", "verified": false },
    { "id": "mn-006", "type": "meaning_choice", "lesson": null, "context": "迫不及待", "target": "及", "options": ["和、與", "趕上、等到", "以及", "及格"], "answer": 1, "explanation": "「及」是到、趕上。急得等不到那時候。", "source": "seed-common", "verified": false },
    { "id": "mn-007", "type": "meaning_choice", "lesson": null, "context": "兵不厭詐", "target": "厭", "options": ["討厭的人", "滿足", "排斥、嫌棄", "壓制"], "answer": 2, "explanation": "「厭」是排斥。用兵打仗不排斥使用計謀。", "source": "seed-common", "verified": false },
    { "id": "mn-008", "type": "meaning_choice", "lesson": null, "context": "川流不息", "target": "川", "options": ["四川", "河流", "平原", "穿過"], "answer": 1, "explanation": "「川」是河流。像河水一樣不停流動。", "source": "seed-common", "verified": false }
  ]
